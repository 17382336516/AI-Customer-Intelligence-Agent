APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:5173

# Optional: recommended free prototype route, OpenAI-compatible.
# Create a key at https://openrouter.ai/keys and paste it into LLM_API_KEY.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
LLM_HTTP_REFERER=http://localhost:5173
LLM_APP_TITLE=AI Customer Intelligence Agent
LLM_TIMEOUT_SECONDS=45

# Analysis defaults
MIN_ANALYZABLE_ROWS=20
MAX_UPLOAD_MB=25
DEFAULT_CLUSTER_COUNT=4
